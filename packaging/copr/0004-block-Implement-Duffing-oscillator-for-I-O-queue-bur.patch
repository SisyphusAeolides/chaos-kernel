From 62552dfb0d36e709bce6f65b4dd24c3ddbf7cb61 Mon Sep 17 00:00:00 2001
From: Sisyphus Aeolides <SisyphusAeolides@pm.me>
Date: Thu, 27 Aug 2026 22:01:30 -0500
Subject: [PATCH 4/5] block: Implement Duffing oscillator for I/O queue burst
 dynamics

---
 block/blk-mq.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/block/blk-mq.c b/block/blk-mq.c
index a26a11c73..6cd774473 100644
--- a/block/blk-mq.c
+++ b/block/blk-mq.c
@@ -3090,7 +3090,30 @@ static bool bio_unaligned(const struct bio *bio, struct request_queue *q)
  * It will not queue the request if there is an error with the bio, or at the
  * request creation.
  */
+static s64 duffing_x = 0;
+
+static s64 duffing_v = 0;
+
+static s64 duffing_t = 0;
+
 void blk_mq_submit_bio(struct bio *bio)
+{
+
+	/* CHAOS KERNEL INJECTION: Duffing Oscillator I/O queue dynamics */
+
+	s64 dt = CHAOS_TO_Q32(1) / 100;
+
+	chaos_duffing_step(CHAOS_TO_Q32(1)/10 /* delta */, CHAOS_TO_Q32(1) /* alpha */, CHAOS_TO_Q32(1)/2 /* beta */, CHAOS_TO_Q32(2) /* gamma */, CHAOS_TO_Q32(1) /* omega */, &duffing_x, &duffing_v, duffing_t, dt);
+
+	duffing_t += dt;
+
+	if (duffing_v > CHAOS_TO_Q32(5)) {
+
+		/* Chaotic burst mode: bypass normal queue limits temporarily */
+
+		bio->bi_opf |= REQ_NOWAIT;
+
+	}
 {
 	struct request_queue *q = bdev_get_queue(bio->bi_bdev);
 	struct blk_plug *plug = current->plug;
-- 
