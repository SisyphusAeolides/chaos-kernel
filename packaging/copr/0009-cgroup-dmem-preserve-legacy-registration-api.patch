+/**
+ * dmem_cgroup_register_region() - Register a region for dev cgroup.
+ * @init: Initialization parameters for the region.
+ * @fmt: Region parameters to register
+ *
+ * This function registers a node in the dmem cgroup with the
+ * name given. After calling this function, the region can be
+ * used for allocations.
+ *
+ * Return: NULL or a struct on success, PTR_ERR on failure.
+ */
+struct dmem_cgroup_region *
+dmem_cgroup_register_region(const struct dmem_cgroup_init *init,
+			    const char *fmt, ...)
+{
+	struct dmem_cgroup_region *ret;
+	va_list ap;
+
+	va_start(ap, fmt);
+	ret = dmem_cgroup_register_region_v(init, fmt, ap);
+	va_end(ap);
+
+	return ret;
+}
 EXPORT_SYMBOL_GPL(dmem_cgroup_register_region);
 
+/**
+ * dmem_cgroup_register_region_legacy() - Register a region using the legacy API.
+ * @size: Size of the region in bytes.
+ * @fmt: Region parameters to register
+ *
+ * Compatibility entry point for out-of-tree drivers using the pre-init
+ * structure API. New callers should use dmem_cgroup_register_region().
+ */
+struct dmem_cgroup_region *
+dmem_cgroup_register_region_legacy(u64 size, const char *fmt, ...)
+{
+	struct dmem_cgroup_init init = {
+		.size = size,
+	};
+	struct dmem_cgroup_region *ret;
+	va_list ap;
+
+	va_start(ap, fmt);
+	ret = dmem_cgroup_register_region_v(&init, fmt, ap);
+	va_end(ap);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(dmem_cgroup_register_region_legacy);
