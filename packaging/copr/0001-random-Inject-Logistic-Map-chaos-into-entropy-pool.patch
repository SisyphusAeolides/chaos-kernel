From 1688d0c866c3118c6de18cbeed7acde34bfe763a Mon Sep 17 00:00:00 2001
From: Sisyphus Aeolides <SisyphusAeolides@pm.me>
Date: Thu, 27 Aug 2026 21:55:35 -0500
Subject: [PATCH 1/5] random: Inject Logistic Map chaos into entropy pool

---
 drivers/char/random.c      |  6 ++++++
 include/linux/chaos_math.h | 26 ++++++++++++++++++++++++++
 2 files changed, 32 insertions(+)
 create mode 100644 include/linux/chaos_math.h

diff --git a/drivers/char/random.c b/drivers/char/random.c
index b4da1fb97..1bd255737 100644
--- a/drivers/char/random.c
+++ b/drivers/char/random.c
@@ -50,6 +50,7 @@
 #include <linux/syscalls.h>
 #include <linux/completion.h>
 #include <linux/uuid.h>
+#include <linux/chaos_math.h>
 #include <linux/uaccess.h>
 #include <linux/suspend.h>
 #include <linux/siphash.h>
@@ -1135,11 +1136,16 @@ struct timer_rand_state {
  * value "num" is also added to the pool; it should somehow describe
  * the type of event that just happened.
  */
+static s64 chaos_logistic_state = (1LL << 32) / 2; /* 0.5 */
+static s64 chaos_logistic_r = 17137209139LL; /* ~3.99 in Q32.32 */
+
 static void add_timer_randomness(struct timer_rand_state *state, unsigned int num)
 {
 	unsigned long entropy = random_get_entropy(), now = jiffies, flags;
 	long delta, delta2, delta3;
 	unsigned int bits;
+	chaos_logistic_state = chaos_logistic_map_step(chaos_logistic_r, chaos_logistic_state);
+	entropy ^= (unsigned long)chaos_logistic_state;
 
 	/*
 	 * If we're in a hard IRQ, add_interrupt_randomness() will be called
diff --git a/include/linux/chaos_math.h b/include/linux/chaos_math.h
new file mode 100644
index 000000000..54937ca29
--- /dev/null
+++ b/include/linux/chaos_math.h
@@ -0,0 +1,26 @@
+#ifndef _LINUX_CHAOS_MATH_H
+#define _LINUX_CHAOS_MATH_H
+
+#include <linux/types.h>
+
+/* Q32.32 Fixed Point representation */
+#define CHAOS_Q32_ONE (1LL << 32)
+#define CHAOS_TO_Q32(x) ((s64)((x) * CHAOS_Q32_ONE))
+#define CHAOS_FROM_Q32(x) ((x) / (double)CHAOS_Q32_ONE)
+
+/* Entropy (Logistic Map) */
+extern s64 chaos_logistic_map_step(s64 r, s64 x);
+
+/* Scheduler (Lorenz Attractor) */
+extern void chaos_lorenz_step(s64 sigma, s64 rho, s64 beta,
+                              s64 *x, s64 *y, s64 *z, s64 dt);
+
+/* TCP Congestion (Rössler Attractor) */
+extern void chaos_roessler_step(s64 a, s64 b, s64 c,
+                                s64 *x, s64 *y, s64 *z, s64 dt);
+
+/* I/O (Duffing Oscillator) */
+extern void chaos_duffing_step(s64 delta, s64 alpha, s64 beta, s64 gamma, s64 omega,
+                               s64 *x, s64 *v, s64 t, s64 dt);
+
+#endif /* _LINUX_CHAOS_MATH_H */
-- 
