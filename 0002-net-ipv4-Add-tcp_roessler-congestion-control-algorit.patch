From 2324b6a1cc3b04952530a61f27bde6263d791ac2 Mon Sep 17 00:00:00 2001
From: Sisyphus Aeolides <SisyphusAeolides@pm.me>
Date: Thu, 27 Aug 2026 21:59:08 -0500
Subject: [PATCH 2/5] net/ipv4: Add tcp_roessler congestion control algorithm

---
 net/ipv4/Kconfig        | 14 ++++++
 net/ipv4/Makefile       |  1 +
 net/ipv4/tcp_roessler.c | 97 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 112 insertions(+)
 create mode 100644 net/ipv4/tcp_roessler.c

diff --git a/net/ipv4/Kconfig b/net/ipv4/Kconfig
index 301b47660..098dc2293 100644
--- a/net/ipv4/Kconfig
+++ b/net/ipv4/Kconfig
@@ -492,6 +492,13 @@ config TCP_CONG_BIC
 	  increase provides TCP friendliness.
 	  See http://www.csc.ncsu.edu/faculty/rhee/export/bitcp/
 
+config TCP_CONG_ROESSLER
+	tristate "TCP Roessler Chaotic Congestion Control"
+	default m
+	help
+	  TCP Roessler uses the Rössler attractor to dynamically non-linearize
+	  congestion window scaling.
+
 config TCP_CONG_CUBIC
 	tristate "CUBIC TCP"
 	default y
@@ -721,6 +728,13 @@ endchoice
 
 endif
 
+config TCP_CONG_ROESSLER
+	tristate "TCP Roessler Chaotic Congestion Control"
+	default m
+	help
+	  TCP Roessler uses the Rössler attractor to dynamically non-linearize
+	  congestion window scaling.
+
 config TCP_CONG_CUBIC
 	tristate
 	depends on !TCP_CONG_ADVANCED
diff --git a/net/ipv4/Makefile b/net/ipv4/Makefile
index 06e21c26b..97be5338e 100644
--- a/net/ipv4/Makefile
+++ b/net/ipv4/Makefile
@@ -48,6 +48,7 @@ obj-$(CONFIG_TCP_CONG_BBR) += tcp_bbr.o
 obj-$(CONFIG_TCP_CONG_BIC) += tcp_bic.o
 obj-$(CONFIG_TCP_CONG_CDG) += tcp_cdg.o
 obj-$(CONFIG_TCP_CONG_CUBIC) += tcp_cubic.o
+obj-$(CONFIG_TCP_CONG_ROESSLER) += tcp_roessler.o
 obj-$(CONFIG_TCP_CONG_DCTCP) += tcp_dctcp.o
 obj-$(CONFIG_TCP_CONG_WESTWOOD) += tcp_westwood.o
 obj-$(CONFIG_TCP_CONG_HSTCP) += tcp_highspeed.o
diff --git a/net/ipv4/tcp_roessler.c b/net/ipv4/tcp_roessler.c
new file mode 100644
index 000000000..0c7295a3b
--- /dev/null
+++ b/net/ipv4/tcp_roessler.c
@@ -0,0 +1,97 @@
+#include <linux/module.h>
+#include <net/tcp.h>
+#include <linux/chaos_math.h>
+
+/* Rössler Attractor parameters in Q32.32 */
+static s64 roessler_a = 858993459LL;  /* 0.2 */
+static s64 roessler_b = 858993459LL;  /* 0.2 */
+static s64 roessler_c = 24483781409LL; /* 5.7 */
+
+struct roessler_data {
+	s64 x;
+	s64 y;
+	s64 z;
+};
+
+static void tcp_roessler_init(struct sock *sk)
+{
+	struct roessler_data *ca = inet_csk_ca(sk);
+	/* Initialize attractor to a stable point */
+	ca->x = CHAOS_TO_Q32(1);
+	ca->y = CHAOS_TO_Q32(1);
+	ca->z = CHAOS_TO_Q32(1);
+}
+
+static void tcp_roessler_cong_avoid(struct sock *sk, u32 ack, u32 acked)
+{
+	struct tcp_sock *tp = tcp_sk(sk);
+	struct roessler_data *ca = inet_csk_ca(sk);
+	s64 dt = CHAOS_TO_Q32(tp->srtt_us >> 3) / 1000000; /* dt scaled by RTT */
+	
+	if (dt == 0) dt = CHAOS_TO_Q32(1) / 100; /* fallback dt = 0.01 */
+
+	/* Step the Rössler attractor */
+	chaos_roessler_step(roessler_a, roessler_b, roessler_c, &ca->x, &ca->y, &ca->z, dt);
+
+	/* Map the x-coordinate to congestion window growth */
+	/* Rössler x typically ranges from -10 to 10. We map it to cwnd changes. */
+	if (ca->x > 0) {
+		tcp_slow_start(tp, acked);
+	} else {
+		/* Add a fractional window increase during chaotic contraction */
+		tcp_cong_avoid_ai(tp, tp->snd_cwnd, 1);
+	}
+}
+
+static void tcp_roessler_set_state(struct sock *sk, u8 new_state)
+{
+	struct roessler_data *ca = inet_csk_ca(sk);
+	if (new_state == TCP_CA_Loss) {
+		/* A loss event spikes the Z-axis, throwing it into a chaotic spike */
+		ca->z += CHAOS_TO_Q32(10);
+	}
+}
+
+static u32 tcp_roessler_ssthresh(struct sock *sk)
+{
+	const struct tcp_sock *tp = tcp_sk(sk);
+	struct roessler_data *ca = inet_csk_ca(sk);
+	
+	/* The threshold dynamically shrinks based on the Y coordinate of the attractor */
+	u32 shrink = (u32)(ca->y >> 32);
+	return max_t(u32, tp->snd_cwnd - shrink, 2U);
+}
+
+static u32 tcp_roessler_undo_cwnd(struct sock *sk)
+{
+	const struct tcp_sock *tp = tcp_sk(sk);
+	return max(tp->snd_cwnd, tp->snd_ssthresh);
+}
+
+static struct tcp_congestion_ops tcp_roessler __read_mostly = {
+	.init		= tcp_roessler_init,
+	.ssthresh	= tcp_roessler_ssthresh,
+	.cong_avoid	= tcp_roessler_cong_avoid,
+	.set_state	= tcp_roessler_set_state,
+	.undo_cwnd	= tcp_roessler_undo_cwnd,
+	.owner		= THIS_MODULE,
+	.name		= "roessler",
+};
+
+static int __init tcp_roessler_register(void)
+{
+	BUILD_BUG_ON(sizeof(struct roessler_data) > ICSK_CA_PRIV_SIZE);
+	return tcp_register_congestion_control(&tcp_roessler);
+}
+
+static void __exit tcp_roessler_unregister(void)
+{
+	tcp_unregister_congestion_control(&tcp_roessler);
+}
+
+module_init(tcp_roessler_register);
+module_exit(tcp_roessler_unregister);
+
+MODULE_AUTHOR("Chaos Kernel");
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("TCP Roessler Chaotic Congestion Control");
-- 
